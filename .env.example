# Local Postgres username for docker compose.
POSTGRES_USER=app

# Local Postgres password for docker compose.
POSTGRES_PASSWORD=app_secret

# Local Postgres database name for docker compose.
POSTGRES_DB=app

# Local backend host port.
BACKEND_PORT=8080

# Local frontend host port.
FRONTEND_PORT=3000

# Browser-visible API base URL for frontend.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Server-side API origin used by frontend container.
API_ORIGIN=http://backend:8080
