# Compose database user.
POSTGRES_USER=app

# Compose database password. Change locally; do not commit secrets.
POSTGRES_PASSWORD=app_secret

# Compose database name.
POSTGRES_DB=app

# Published backend port.
BACKEND_PORT=8080

# Published frontend port.
FRONTEND_PORT=3000

# Browser-visible API origin for frontend builds.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Server-side API origin for frontend runtime.
API_ORIGIN=http://backend:8080
